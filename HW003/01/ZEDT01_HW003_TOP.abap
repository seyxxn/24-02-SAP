DATA : GC_S_INDEX_ROWS TYPE LVC_S_ROW.
DATA : GV_COUNT TYPE I.
DATA : GV_CHECK TYPE C.

"PDF 파일
DATA : GV_FILENAME TYPE STRING,
      GT_PDF_CONTENT TYPE TABLE OF TLINE.


"주문관리 테이블
DATA : BEGIN OF GS_ORDER,
      ZORDNO LIKE ZEDT01_100-ZORDNO,      "주문번호
      ZIDCODE LIKE ZEDT01_100-ZIDCODE,    "회원ID
      ZMATNR LIKE ZEDT01_100-ZMATNR,      "제품번호
      ZMTART LIKE ZEDT01_100-ZMTART,      "제품유형
      ZMATNAME LIKE ZEDT01_100-ZMATNAME,  "제품명
      ZVOLUM LIKE ZEDT01_100-ZVOLUM,      "수량
      VOLUM LIKE ZEDT01_100-VOLUM,        "VOLUME
      VRKME LIKE ZEDT01_100-VRKME,        "SALES UNIT
      ZNSAMT LIKE ZEDT01_100-ZNSAMT,      "판매금액
      ZSLAMT LIKE ZEDT01_100-ZSLAMT,      "매출금액
      ZDCAMT LIKE ZEDT01_100-ZDCAMT,      "할인금액
      ZDC_FG LIKE ZEDT01_100-ZDC_FG,      "할인구분
      ZSALE_FG TYPE C LENGTH 2,           "매출구분
      ZRET_FG TYPE C LENGTH 4,            "반품구분
      ZJDATE LIKE ZEDT01_100-ZJDATE,      "판매일자
      ZRDATE LIKE ZEDT01_100-ZRDATE,      "반품일자
      ZCOLOR TYPE C LENGTH 4,             "신호등
      END OF GS_ORDER.
DATA : GT_ORDER LIKE TABLE OF GS_ORDER.
DATA : GT_ORDER_ALV LIKE TABLE OF GS_ORDER.
FIELD-SYMBOLS : <FS_ORDER> LIKE GS_ORDER.

"주문관리 PDF 테이블
DATA : BEGIN OF GS_ORDER_PDF,
      ZORDNO LIKE ZEDT01_100-ZORDNO,      "주문번호
      ZIDCODE LIKE ZEDT01_100-ZIDCODE,    "회원ID
      ZMATNR LIKE ZEDT01_100-ZMATNR,      "제품번호
      ZMATNAME LIKE ZEDT01_100-ZMATNAME,  "제품명
      ZSLAMT LIKE ZEDT01_100-ZSLAMT,      "매출금액
      ZJDATE LIKE ZEDT01_100-ZJDATE,      "판매일자
      END OF GS_ORDER_PDF.
DATA : GT_ORDER_PDF LIKE TABLE OF GS_ORDER_PDF.

"배송관리 테이블
DATA : BEGIN OF GS_DELIVER,
      ZORDNO LIKE ZEDT01_101-ZORDNO,      "주문번호
      ZIDCODE LIKE ZEDT01_101-ZIDCODE,    "회원ID
      ZMATNR LIKE ZEDT01_101-ZMATNR,      "제품번호
      ZMTART LIKE ZEDT01_101-ZMTART,      "제품유형
      ZMATNAME LIKE ZEDT01_101-ZMATNAME,  "제품명
      ZVOLUM LIKE ZEDT01_101-ZVOLUM,      "수량
      VOLUM LIKE ZEDT01_101-VOLUM,        "VOLUME
      VRKME LIKE ZEDT01_101-VRKME,        "SALES UNIT
      ZSLAMT LIKE ZEDT01_101-ZSLAMT,      "매출금액
      ZDFLAG TYPE C LENGTH 4,             "배송현황
      ZDGUBUN TYPE C LENGTH 3,            "배송지역
      ZDDATE LIKE ZEDT01_101-ZDDATE,      "배송일자
      ZRDATE LIKE ZEDT01_101-ZRDATE,      "반품일자
      ZFLAG LIKE ZEDT01_101-ZFLAG,        "체크구분
      ZCOLOR TYPE C LENGTH 4,             "신호등
      END OF GS_DELIVER.
DATA : GT_DELIVER LIKE TABLE OF GS_DELIVER.
DATA : GT_DELIVER_ALV LIKE TABLE OF GS_DELIVER.
FIELD-SYMBOLS : <FS_DELIVER> LIKE GS_DELIVER.

"배송관리 PDF 테이블
DATA : BEGIN OF GS_DELIVER_PDF,
      ZORDNO LIKE ZEDT01_101-ZORDNO,      "주문번호
      ZIDCODE LIKE ZEDT01_101-ZIDCODE,    "회원ID
      ZMATNR LIKE ZEDT01_101-ZMATNR,      "제품번호
      ZMATNAME LIKE ZEDT01_101-ZMATNAME,  "제품명
      ZSLAMT LIKE ZEDT01_101-ZSLAMT,      "매출금액
      ZDDATE LIKE ZEDT01_101-ZDDATE,      "배송일자
      END OF GS_DELIVER_PDF.
DATA : GT_DELIVER_PDF LIKE TABLE OF GS_DELIVER_PDF.


