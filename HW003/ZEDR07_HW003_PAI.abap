MODULE USER_COMMAND_0100 INPUT.
  CASE SY-UCOMM.
    WHEN 'PDF'.
*     MESSAGE 'PDF' TYPE 'I'.
        CALL METHOD GO_EVENT->HANDLER_USER_COMMAND
                EXPORTING
                  e_ucomm = sy-ucomm.
  ENDCASE.

ENDMODULE.
*&---------------------------------------------------------------------*
*&      Module  EXIT_COMMAND  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE EXIT_COMMAND INPUT.
  CASE OK_CODE.
    WHEN 'BACK' OR 'CANC'.
      LEAVE TO SCREEN 0.
    WHEN 'EXIT'.
      LEAVE PROGRAM.
   ENDCASE.
ENDMODULE.
